# ============================================================
#  SIRASMA — Environment Variables Example
#  Salin file ini menjadi .env dan isi nilainya.
#  JANGAN commit file .env ke repository.
# ============================================================

# --- Backend ---
NODE_ENV=development
BACKEND_PORT=3000

# --- JWT Authentication ---
JWT_ACCESS_SECRET=sirasma_jwt_access_secret_key_change_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
# JWT_ACCESS_SECRET wajib diganti dengan nilai acak minimal 32 karakter.
# Refresh token bersifat opaque dan disimpan sebagai hash sesi; tidak memakai JWT secret.
CSRF_SECRET=sirasma_csrf_secret_key_change_in_production_32chars

# Comma-separated browser origins. Mandatory in production; local defaults are
# used only outside production. Never use wildcard origins with credentials.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# lax is appropriate for same-site deployment. Use none only for a deliberate
# cross-site deployment; Secure will then be forced on the refresh cookie.
AUTH_COOKIE_SAME_SITE=lax

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/sirasma_db?schema=public"

# --- Development demo seed only ---
# Wajib diisi secara lokal sebelum menjalankan pnpm seed:demo. Jangan commit nilai sebenarnya.
DEMO_USER_PASSWORD=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:3000/api

