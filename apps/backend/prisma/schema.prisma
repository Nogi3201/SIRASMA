  users_check_out_requests_requested_byTousers users            @relation("check_out_requests_requested_byTousers", fields: [requested_by], references: [id], onUpdate: NoAction)
  users_check_out_requests_validated_byTousers users?           @relation("check_out_requests_validated_byTousers", fields: [validated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([assignment_id, status], map: "ix_checkout_assignment")
}

