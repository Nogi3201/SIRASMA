/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model waiting_list_entries {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  waiting_list_id     String                @db.Uuid
  reservation_id      String?               @db.Uuid
  group_id            String?               @db.Uuid
  queue_number        BigInt
  status              waiting_entry_status  @default(WAITING)
  registered_at       DateTime              @default(now()) @db.Timestamptz(6)
  on_hold_at          DateTime?             @db.Timestamptz(6)
  reservation_groups  reservation_groups?   @relation(fields: [group_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reservations        reservations?         @relation(fields: [reservation_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  waiting_lists       waiting_lists         @relation(fields: [waiting_list_id], references: [id], onUpdate: NoAction)
  waiting_list_offers waiting_list_offers[]

  @@unique([waiting_list_id, queue_number])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model waiting_list_offers {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entry_id             String               @db.Uuid
  room_id              String               @db.Uuid
  status               offer_status         @default(PENDING)
  offered_at           DateTime             @default(now()) @db.Timestamptz(6)
  deadline_at          DateTime             @db.Timestamptz(6)
  responded_at         DateTime?            @db.Timestamptz(6)
  waiting_list_entries waiting_list_entries @relation(fields: [entry_id], references: [id], onUpdate: NoAction)
  rooms                rooms                @relation(fields: [room_id], references: [id], onUpdate: NoAction)

  @@index([entry_id, offered_at(sort: Desc)], map: "ix_waiting_offers_entry")
}

model waiting_lists {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queue_type           waiting_queue_type
  academic_period_id   String                 @db.Uuid
  building_id          String?                @db.Uuid
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  waiting_list_entries waiting_list_entries[]
  academic_periods     academic_periods       @relation(fields: [academic_period_id], references: [id], onUpdate: NoAction)
  buildings            buildings?             @relation(fields: [building_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([queue_type, academic_period_id, building_id])
}

