generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model academic_periods {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String          @unique @db.VarChar(120)
  start_date            DateTime        @db.Date
  end_date              DateTime        @db.Date
  registration_open_at  DateTime        @db.Timestamptz(6)
  registration_close_at DateTime        @db.Timestamptz(6)
  is_active             Boolean         @default(false)
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  updated_at            DateTime        @default(now()) @db.Timestamptz(6)
  reservations          reservations[]
  waiting_lists         waiting_lists[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model academic_verifications {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id       String              @db.Uuid
  reviewer_id      String?             @db.Uuid
  status           verification_status @default(PENDING)
  notes            String?
  rejection_reason String?
  reviewed_at      DateTime?           @db.Timestamptz(6)
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  users            users?              @relation(fields: [reviewer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  student_profiles student_profiles    @relation(fields: [student_id], references: [id], onUpdate: NoAction)

  @@index([student_id, created_at(sort: Desc)], map: "ix_academic_verifications_student")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  action      String   @db.VarChar(120)
  entity_type String   @db.VarChar(120)
  entity_id   String?  @db.Uuid
  old_values  Json?
  new_values  Json?
  result      String?  @db.VarChar(40)
  ip_address  String?  @db.Inet
  user_agent  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([entity_type, entity_id, created_at(sort: Desc)], map: "ix_audit_entity")
  @@index([user_id, created_at(sort: Desc)], map: "ix_audit_user_created")
}

model buildings {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String          @unique @db.VarChar(120)
  gender_policy gender_policy   @default(UNSET)
  description   String?
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  rooms         rooms[]
  waiting_lists waiting_lists[]
}

model check_ins {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignment_id    String           @unique @db.Uuid
  checked_in_at    DateTime         @default(now()) @db.Timestamptz(6)
  recorded_by      String?          @db.Uuid
  room_assignments room_assignments @relation(fields: [assignment_id], references: [id], onUpdate: NoAction)
  users            users?           @relation(fields: [recorded_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

